# Copy to .env and fill in only what you need. .env is ignored by git. No real values here.

# --- Site (web/) ---------------------------------------------------------------
# Leave both empty to use the production project. For a local database, `npx supabase status`
# prints the API URL and the publishable key. For staging, copy them from the staging dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Local Supabase (supabase/config.toml) ------------------------------------
# Needed only to try Google sign-in against the local database.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- GitHub Actions (set in GitHub, never in this file) -------------------------
# Environments "staging", "production-plan", "production":
#   secret SUPABASE_ACCESS_TOKEN; variable SUPABASE_PROJECT_REF
# Repository variable PRODUCTION_PROJECT_REF (guards staging from pointing at production).
# Edge Function secrets (GuideStar credentials, OCR keys) are set in each Supabase project
# with `supabase secrets set`, not in GitHub.
