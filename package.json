{
  "name": "jerusalem-consultants-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:ts && npm run test:supabase && npm run test:web && npm run test:components && npm run test:ui",
    "test:ts": "node --test \"supabase/functions/tests/*-test.ts\"",
    "test:web": "node --test \"web/tests/*-test.ts\" \"scripts/bundle/tests/*-test.ts\"",
    "test:ui": "node --test tests/*.test.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run types:db:check && npm test && npm run build:web && npm run size:check",
    "test:supabase": "node --test \"supabase/tests/*-test.ts\"",
    "build:web": "vite build",
    "dev:web": "vite",
    "types:db": "node scripts/schema/generate-types.ts",
    "types:db:check": "node scripts/schema/generate-types.ts --check",
    "test:components": "vitest run",
    "size:check": "node scripts/bundle/check-bundle-size.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  }
}
